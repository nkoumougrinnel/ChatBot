# ============================================================================
# Exemple de configuration d'environnement — Chatbot SUP'PTIC
# Copiez ce fichier en `.env` (à la racine ou dans backend/) et renseignez
# les valeurs. NE JAMAIS commiter le fichier `.env` réel.
# ============================================================================

# --- Django ---------------------------------------------------------------
# Clé secrète Django. Générez-en une avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changez-moi-en-production

# Mode debug : "True" en développement uniquement, "False" en production.
DEBUG=True

# Hôtes autorisés, séparés par des virgules. Pour un sous-domaine, utilisez un
# point initial (ex : .up.railway.app). Laissez vide pour les valeurs par défaut.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines CORS autorisées en production (séparées par des virgules).
# En mode DEBUG, toutes les origines sont autorisées automatiquement.
# Origines frontend (React Vite, anciennes versions HTML)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# --- Base de données ------------------------------------------------------
# URL de connexion. Vide => SQLite local (backend/db.sqlite3).
# Postgres : postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Moteur RAG / LLM -----------------------------------------------------
# Clé API Google Gemini (https://aistudio.google.com/app/apikey).
# Requise pour le niveau 4 LLM du pipeline Gen3. Sans elle : CONV + FAISS + TF-IDF restent actifs.
GEMINI_API_KEY=<votre-cle-gemini>
GEMINI_MODEL=gemini-2.0-flash

# Seuils de pertinence Gen3 (optionnel)
# SCORE_DIRECT=0.52
# TFIDF_MIN_SCORE=0.35
# TFIDF_ANSWER_MIN=0.38
# FAISS_MEDIUM_MIN=0.45
# LLM_CONTEXT_MIN=0.22

# Après clone : python manage.py setup_gen3 --allow-download

# Mode hors ligne HuggingFace ("1" pour utiliser le modèle local bundlé).
HF_OFFLINE=1
