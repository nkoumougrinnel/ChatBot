# Variables Railway — service backend Django
# Copier dans Railway → Variables (ou via CLI railway variables set)

SECRET_KEY=<generer-une-cle-longue-aleatoire>
DEBUG=False
ALLOWED_HOSTS=.up.railway.app
CORS_ALLOWED_ORIGINS=https://VOTRE-SITE.netlify.app

# Injectée automatiquement si plugin PostgreSQL lié :
# DATABASE_URL=postgres://...

GEMINI_API_KEY=<votre-cle-gemini>
GEMINI_MODEL=gemini-2.0-flash
HF_OFFLINE=1

# Optionnel — bootstrap données au premier déploiement (puis retirer ou mettre à 0)
# RUN_BOOTSTRAP=1
# SKIP_GEN3=1

# Performance Gunicorn (optionnel)
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=120
# LOG_LEVEL=INFO
