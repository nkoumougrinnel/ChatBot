# Docker Compose — copier à la racine du projet :
#   copy deploy\docker.env.example .env

# --- PostgreSQL (service db) ---
POSTGRES_DB=supone
POSTGRES_USER=supone
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort

# --- Django (service api) ---
SECRET_KEY=changez-moi-cle-secrete-longue
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,api
# Domaine public du serveur (ex. chatbot.supptic.cm ou IP) :
# ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com,192.168.1.10

# CORS : vide si frontend servi par Nginx (même origine via proxy /api)
CORS_ALLOWED_ORIGINS=

# HTTPS derrière reverse proxy : laisser True si TLS terminé devant Nginx
SECURE_SSL_REDIRECT=False

GEMINI_API_KEY=<votre-cle-gemini>
GEMINI_MODEL=gemini-2.0-flash
HF_OFFLINE=1

# Bootstrap automatique au premier démarrage (demo + Gen3), puis retirer :
# RUN_BOOTSTRAP=1
# SKIP_GEN3=1

WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

# --- Frontend (service web) ---
HTTP_PORT=80
# Laisser vide : Nginx proxy /api → api (recommandé sur serveur)
VITE_API_URL=
